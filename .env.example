# NeonReaper — Environment Template
# Copy to .env (never commit .env)

# Vite uses VITE_ prefix for client-exposed vars.
# All vars here are CLIENT-SIDE — never put secrets here.

VITE_APP_NAME=NeonReaper
VITE_APP_VERSION=0.1.0

# Optional: build-time toggle for debug overlays
# VITE_DEBUG_HUD=false
